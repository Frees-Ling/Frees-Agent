{
  "name": "frees-agent-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "frees-agent": "bin/ai-agent.js",
    "ai-agent": "./bin/ai-agent.js"
  },
  "scripts": {
    "start": "node ./bin/ai-agent.js",
    "chat": "node ./bin/ai-agent.js chat",
    "edit": "node ./bin/ai-agent.js edit",
    "complete": "node ./bin/ai-agent.js complete",
    "doctor": "node ./bin/ai-agent.js doctor",
    "test": "node --test",
    "build:bundle": "mkdir dist && npx esbuild ./src/cli.js --bundle --platform=node --target=node20 --outfile=dist/frees-agent.js && npx cpy \"docs/**/*\" dist/docs",    
    "build:exe": "npx pkg . --targets node18-win-x64 --output release/frees-agent.exe",
    "build": "npm run build:bundle && npm run build:exe"
  },
  "pkg": {
  "scripts": ["bin/ai-agent.js"],
  "assets": ["docs/**/*"],
  "targets": ["node18-win-x64"]
},
  "devDependencies": {
    "cpy-cli": "^7.0.0",
    "esbuild": "^0.19.0",
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
